# Copy to .env.local for local overrides. Never commit real values.

# Postgres connection string (Neon, Supabase, or any Postgres 14+).
# Leave empty locally to use the embedded dev database in ./.data (no setup needed).
DATABASE_URL=

# Optional: direct (non-pooled) connection used only for migrations at build time.
DATABASE_URL_UNPOOLED=

# Public origin used in metadata and link previews, e.g. https://dibs.example.com
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=

# Random string. Vercel Cron sends it as a Bearer token to /api/cron/cleanup.
CRON_SECRET=

# Random string used to salt hashed IPs for rate limiting.
RATE_LIMIT_SALT=
